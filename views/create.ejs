<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Pack a parcel - A Little Box of Goodies</title>
<link rel="stylesheet" href="/public/css/style.css" />
<style>
  .top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    background: var(--paper);
    border-bottom: 2px solid var(--ink-black);
  }
  .top-nav a {
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink-black);
  }
  .draft-btn {
    background: var(--butter);
    border: 2px solid var(--ink-black);
    color: var(--ink-black);
    width: 100%;
    padding: 12px;
    border-radius: 999px;
    font-family: 'Fredoka', sans-serif;
    font-size: 15px;
    font-weight: 600;
    margin-top: 10px;
    box-shadow: 2px 2px 0px var(--ink-black);
    cursor: pointer;
  }
</style>
</head>
<body>

<div class="top-nav">
  <a href="/dashboard">← Back to Dashboard</a>
  <span>Logged in as: <strong><%= currentUser ? currentUser.username : '' %></strong></span>
</div>

<div class="shell">
  <div class="pack-station">
    <div class="header-block">
      <p class="eyebrow">✨ pack a little something ✨</p>
      <h1>Make someone's day a tiny bit sweeter.</h1>
      <p>Tuck in photos, a doodle, a song, a video, or a little note. Seal it up and it'll land straight in their inbox.</p>
    </div>

    <!-- Hidden input to store draft id if editing -->
    <input type="hidden" id="packageId" value="<%= draft ? draft.id : '' %>" />

    <div class="two-col">
      <div class="field-group">
        <label for="recipientName">To (Name)</label>
        <input type="text" id="recipientName" placeholder="Their name" value="<%= draft ? draft.recipient_name : '' %>" />
      </div>
      <div class="field-group">
        <label for="recipientUsername">Recipient Username</label>
        <input type="email" id="recipientUsername" placeholder="them@littlegoodies.com" value="<%= draft ? draft.recipient_username : '' %>" required />
      </div>
    </div>

    <div class="field-group">
      <label for="note">A little note (optional)</label>
      <textarea id="note" placeholder="Something sweet they'll see first..."><%= draft ? draft.note : '' %></textarea>
    </div>

    <hr style="border: none; border-top: 2px dashed var(--ink-black); margin: 32px 0;" />

    <p class="eyebrow" style="margin-bottom: 14px;">🎀 what's going in?</p>
    <div class="item-tabs">
      <button type="button" class="tab-btn active" data-type="image">📸 Photo</button>
      <button type="button" class="tab-btn" data-type="drawing">🎨 Doodle</button>
      <button type="button" class="tab-btn" data-type="video">🎬 Video</button>
      <button type="button" class="tab-btn" data-type="music">🎵 Song</button>
      <button type="button" class="tab-btn" data-type="text">💌 Note</button>
      <button type="button" class="tab-btn" data-type="jewellery">💎 Jewellery</button>
      <button type="button" class="tab-btn" data-type="bouquet">💐 Bouquet</button>
      <button type="button" class="tab-btn" data-type="coupon">🎟️ Coupon</button>
    </div>

    <div class="item-input-panel">
      <!-- image -->
      <div class="item-panel" data-panel="image">
        <label>Upload a photo</label>
        <input type="file" id="imageFile" accept="image/*" />
        <div class="field-group" style="margin-top:12px;">
          <label>Caption (optional)</label>
          <input type="text" id="imageCaption" placeholder="Say something about it" />
        </div>
        <button type="button" class="add-item-btn" data-add="image">Tuck it in ✨</button>
      </div>

      <!-- drawing -->
      <div class="item-panel" data-panel="drawing" style="display:none;">
        <label>Doodle something 🖍️</label>
        <canvas class="draw-pad" id="drawPad" width="560" height="320"></canvas>
        <div class="draw-tools">
          <input type="color" id="drawColor" value="#1A1A1A" title="Pen color" />
          <button type="button" id="drawPenBtn" class="tool-active">✏️ Pen</button>
          <button type="button" id="drawEraserBtn">🧽 Eraser</button>
          <input type="color" id="fillColor" value="#FFFFFF" title="Fill color" />
          <button type="button" id="fillCanvasBtn">🪣 Fill</button>
          <button type="button" id="drawClear">Clear</button>
          <span style="font-family:'Quicksand',sans-serif;font-size:12px;color:var(--plum);">draw with mouse or finger</span>
        </div>
        <button type="button" class="add-item-btn" data-add="drawing" style="margin-top:14px;">Tuck it in ✨</button>
      </div>

      <!-- video -->
      <div class="item-panel" data-panel="video" style="display:none;">
        <label>YouTube link</label>
        <input type="url" id="videoUrl" placeholder="https://youtube.com/watch?v=..." />
        <button type="button" class="add-item-btn" data-add="video" style="margin-top:14px;">Tuck it in ✨</button>
      </div>

      <!-- music -->
      <div class="item-panel" data-panel="music" style="display:none;">
        <label>Spotify link</label>
        <input type="url" id="musicUrl" placeholder="https://open.spotify.com/track/..." />
        <button type="button" class="add-item-btn" data-add="music" style="margin-top:14px;">Tuck it in ✨</button>
      </div>

      <!-- text -->
      <div class="item-panel" data-panel="text" style="display:none;">
        <label>Write a little note</label>
        <div class="emoji-bar">
          <button type="button" id="emojiToggleBtn" aria-label="Add emoji">😊</button>
          <div id="emojiPicker" class="emoji-picker" hidden>
            <div class="emoji-picker-head">
              <span>pick one</span>
              <button type="button" id="emojiCloseBtn" aria-label="Close">✕</button>
            </div>
            <div class="emoji-grid" id="emojiGrid"></div>
          </div>
        </div>
        <textarea id="textNote" placeholder="Whatever you want to say..." style="width:100%;min-height:100px;background:var(--paper);border:2px solid var(--ink-black);border-radius:10px;padding:12px;color:var(--ink-black);font-family:'Quicksand',sans-serif;"></textarea>
        <button type="button" class="add-item-btn" data-add="text" style="margin-top:14px;">Tuck it in ✨</button>
      </div>

      <!-- jewellery -->
      <div class="item-panel" data-panel="jewellery" style="display:none;">
        <label>Design a little piece of jewellery 💎</label>

        <div class="two-col">
          <div class="field-group" style="margin-bottom:12px;">
            <label style="font-size:11px;">For</label>
            <select id="jwCategory" class="cute-select">
              <option value="women">Women's</option>
              <option value="men">Men's</option>
            </select>
          </div>
          <div class="field-group" style="margin-bottom:12px;">
            <label style="font-size:11px;">Piece</label>
            <select id="jwType" class="cute-select"></select>
          </div>
        </div>

        <div class="two-col">
          <div class="field-group" style="margin-bottom:12px;">
            <label style="font-size:11px;">Metal</label>
            <select id="jwMetal" class="cute-select">
              <option value="#D4AF37">Gold</option>
              <option value="#C0C0C0">Silver</option>
              <option value="#E8B4B8">Rose Gold</option>
            </select>
          </div>
          <div class="field-group" style="margin-bottom:12px;">
            <label style="font-size:11px;">Style</label>
            <select id="jwStyle" class="cute-select">
              <option value="minimal">Minimal</option>
              <option value="beaded">Beaded</option>
              <option value="chain">Chain</option>
              <option value="charm">Charm</option>
              <option value="engraved">Engraved</option>
            </select>
          </div>
        </div>

        <div class="two-col">
          <div class="field-group" style="margin-bottom:12px;">
            <label style="font-size:11px;">Charm / Symbol</label>
            <select id="jwCharm" class="cute-select">
              <option value="">None</option>
              <option value="❤️">Heart</option>
              <option value="⭐">Star</option>
              <option value="🌙">Moon</option>
              <option value="🌸">Flower</option>
              <option value="♾️">Infinity</option>
              <option value="🦋">Butterfly</option>
            </select>
          </div>
          <div class="field-group" style="margin-bottom:12px;">
            <label style="font-size:11px;">Initials (optional)</label>
            <input type="text" id="jwInitials" maxlength="3" placeholder="e.g. A.K" />
          </div>
        </div>

        <div class="field-group" style="margin-bottom:12px;">
          <label style="font-size:11px;">Short Engraving (optional)</label>
          <input type="text" id="jwEngraving" maxlength="24" placeholder="e.g. always & forever" />
        </div>

        <div class="preview-box" id="jwPreview"></div>

        <button type="button" class="add-item-btn" data-add="jewellery" style="margin-top:14px;">Tuck it in ✨</button>
      </div>

      <!-- bouquet -->
      <div class="item-panel" data-panel="bouquet" style="display:none;">
        <label>Build a little bouquet 💐</label>

        <div class="flower-picker" id="flowerPicker"></div>

        <div class="two-col" style="margin-top:14px;">
          <div class="field-group" style="margin-bottom:12px;">
            <label style="font-size:11px;">Wrapping</label>
            <select id="bqWrap" class="cute-select">
              <option value="#FFDFEC">Blush Paper</option>
              <option value="#FFF3B0">Kraft & Butter</option>
              <option value="#E4DEFF">Lavender</option>
              <option value="#B3E5FC">Sky Blue</option>
              <option value="#FFFBF4">Classic Cream</option>
            </select>
          </div>
          <div class="field-group" style="margin-bottom:12px;">
            <label style="font-size:11px;">Ribbon</label>
            <select id="bqRibbon" class="cute-select">
              <option value="#E8639A">Rose</option>
              <option value="#6C4AB6">Grape</option>
              <option value="#B8F2D4">Mint</option>
              <option value="#1A1A1A">Black</option>
            </select>
          </div>
        </div>

        <div class="field-group" style="margin-bottom:12px;">
          <label style="font-size:11px;">Card message (optional)</label>
          <input type="text" id="bqMessage" maxlength="60" placeholder="for you, always..." />
        </div>

        <div class="preview-box" id="bqPreview"></div>

        <button type="button" class="add-item-btn" data-add="bouquet" style="margin-top:14px;">Tuck it in ✨</button>
      </div>

      <!-- coupon -->
      <div class="item-panel" data-panel="coupon" style="display:none;">
        <label>Make a little coupon 🎟️</label>

        <div class="coupon-templates" id="couponTemplates"></div>

        <div class="field-group" style="margin-bottom:12px;">
          <label style="font-size:11px;">Title</label>
          <input type="text" id="cpTitle" maxlength="40" placeholder="Movie Night" />
        </div>
        <div class="field-group" style="margin-bottom:12px;">
          <label style="font-size:11px;">Description</label>
          <textarea id="cpDesc" maxlength="120" placeholder="Redeemable for one cozy movie night, my treat."></textarea>
        </div>
        <div class="field-group" style="margin-bottom:12px;">
          <label style="font-size:11px;">Expiry (optional)</label>
          <input type="text" id="cpExpiry" placeholder="e.g. 31 Dec 2026" />
        </div>

        <div class="preview-box" id="cpPreview"></div>

        <button type="button" class="add-item-btn" data-add="coupon" style="margin-top:14px;">Tuck it in ✨</button>
      </div>
    </div>

    <ul class="packed-list" id="packedList"></ul>

    <div id="statusMsg"></div>
  </div>

  <div class="parcel-preview">
    <div class="stamp">made<br/>with<br/>love</div>
    <div>
      <div class="contents-count" id="itemCount">0</div>
      <p>goodies tucked in</p>
      <div class="address" style="margin-top:36px;">
        <span class="label">To</span>
        <span id="previewTo"><%= draft && draft.recipient_username ? draft.recipient_username : '—' %></span>
        <span class="label" style="margin-top:14px;">From</span>
        <span id="previewFrom"><%= currentUser ? currentUser.name : '—' %></span>
      </div>
    </div>
    <div>
      <button type="button" class="send-btn" id="sendBtn">Send with love 💌</button>
      <button type="button" class="draft-btn" id="saveDraftBtn">Save as Draft 📝</button>
      <div class="status-msg" id="sendStatus"></div>
    </div>
  </div>
</div>
<!-- Store draft items safely in a data attribute -->
<div id="draft-data" data-items="<%= JSON.stringify(draftItems || []) %>" style="display: none;"></div>
<script src="/public/js/create.js"></script>
</body>
</html>
